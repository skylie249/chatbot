SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="노사협의회 플랫폼" <your-account@example.com>
SMTP_TO=
ALLOWED_IPS=
GEMINI_API_KEY=
# Shared secret proving a request passed through Cloudflare (see
# api/_lib/clientIp.js and cloudflare-worker.js). Must match the value
# configured as the Worker's CF_SHARED_SECRET variable.
CF_SHARED_SECRET=
