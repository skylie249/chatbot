SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="노사협의회 플랫폼" <your-account@example.com>
SMTP_TO=
ALLOWED_IPS=
GEMINI_API_KEY=
# Fallback used when the Gemini API returns 429 (rate limited).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=
# Shared secret proving a request passed through Cloudflare (see
# api/_lib/clientIp.js). Must match the value set in the Cloudflare
# Transform Rule (or Worker) that injects the x-nexalab-secret header.
CF_SHARED_SECRET=
# Redis (Upstash) - used by api/track.js and api/stats.js to record daily
# site visit / inquiry-access counts. Install a Redis integration from the
# Vercel Marketplace (or an existing legacy KV store) and link it to this
# project; Vercel injects one of these pairs automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
