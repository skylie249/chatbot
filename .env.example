SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="노사협의회 플랫폼" <your-account@example.com>
SMTP_TO=
ALLOWED_IPS=
GEMINI_API_KEY=
# Public hostname the app is served on through Cloudflare. Only requests
# arriving with this Host header are trusted to carry a real
# cf-connecting-ip value. Defaults to on.nexalab.app if unset.
TRUSTED_HOST=on.nexalab.app
