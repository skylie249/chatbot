SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="노사협의회 플랫폼" <your-account@example.com>
SMTP_TO=
ALLOWED_IPS=
GEMINI_API_KEY=
# Fallback used when the Gemini API returns 429 (rate limited).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=
# Shared secret proving a request passed through Cloudflare (see
# api/_lib/clientIp.js). Must match the value set in the Cloudflare
# Transform Rule (or Worker) that injects the x-nexalab-secret header.
CF_SHARED_SECRET=
